<Window
    x:Class="ScamBaitDesk.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScamBaitDesk"
    Title="ScamBait Desk">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="WorkspaceCard" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/></Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right" OverflowButtonVisibility="Visible">
            <AppBarButton Icon="Sync" Label="Sync inbox" Click="Sync_Click"/>
            <AppBarToggleButton x:Name="MonitorButton" Icon="World" Label="Monitor inbox" Click="Monitor_Click"/>
            <AppBarButton Icon="Save" Label="Save case" Click="SaveCase_Click"/>
            <AppBarButton Icon="Download" Label="Export evidence" Click="ExportEvidence_Click"/>
            <AppBarToggleButton x:Name="EmergencyStopButton" Icon="Stop" Label="GLOBAL SEND STOP" Click="EmergencyStop_Click"/>
            <CommandBar.SecondaryCommands><AppBarButton Icon="Setting" Label="Inbox settings" Click="Settings_Click"/><AppBarButton Icon="Permissions" Label="Connect Gmail OAuth" Click="ConnectGmail_Click"/><AppBarButton Icon="Repair" Label="Test mail connection" Click="TestConnection_Click"/><AppBarButton Icon="Contact" Label="Manage personas" Click="Personas_Click"/></CommandBar.SecondaryCommands>
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="22"/>
                    <TextBlock Text="ScamBait Desk" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="12" Padding="10,3">
                        <TextBlock Text="CONTROLLED ENGAGEMENT · MANUAL SEND" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition x:Name="CollectionColumn" Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="10,16">
             <StackPanel Spacing="6"><TextBlock Text="Workspace" FontSize="12" FontWeight="SemiBold" Opacity="0.6" Margin="10,0,0,8"/><ListView x:Name="ShellMenu" SelectionChanged="ShellMenu_SelectionChanged" SelectedIndex="0">
              <ListViewItem Tag="Home"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;"/><TextBlock Text="Home"/></StackPanel></ListViewItem>
              <ListViewItem Tag="Inbox"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE715;"/><TextBlock Text="Inbox"/></StackPanel></ListViewItem>
              <ListViewItem Tag="Case"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8A5;"/><TextBlock Text="Case"/></StackPanel></ListViewItem>
              <ListViewItem Tag="Engage"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE724;"/><TextBlock Text="Engage"/></StackPanel></ListViewItem>
              <ListViewItem Tag="Investigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE721;"/><TextBlock Text="Investigate"/></StackPanel></ListViewItem>
              <ListViewItem Tag="Report"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7C3;"/><TextBlock Text="Report"/></StackPanel></ListViewItem>
              <ListViewItem Tag="Settings"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;"/><TextBlock Text="Settings"/></StackPanel></ListViewItem>
             </ListView><Border Style="{StaticResource WorkspaceCard}" Margin="0,18,0,0"><StackPanel Spacing="3"><TextBlock x:Name="NavCaseTitle" Text="No case selected" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="NavCaseStatus" Text="Choose a message or case" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
            </Border>
            <Grid x:Name="CollectionPane" Grid.Column="1" Padding="14" RowSpacing="10" Background="{ThemeResource LayerFillColorAltBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" Header="Search" PlaceholderText="Messages and cases" TextChanged="SearchBox_TextChanged"/>
                <TabView x:Name="CollectionTabs" Grid.Row="1">
                  <TabViewItem x:Name="InboxCollectionTab" Header="Inbox" IsClosable="False">
                   <ListView x:Name="MessageList" SelectionChanged="MessageList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:InboxMessage">
                            <StackPanel Padding="4" Spacing="3">
                                <TextBlock Text="{x:Bind Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Sender}" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind DirectionDisplay}" FontSize="12" Opacity="0.6"/>
                                <TextBlock Text="{x:Bind ReceivedDisplay}" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                   </ListView>
                  </TabViewItem>
                  <TabViewItem x:Name="CasesCollectionTab" Header="Cases" IsClosable="False">
                   <ListView x:Name="CaseList" SelectionChanged="CaseList_SelectionChanged">
                    <ListView.ItemTemplate><DataTemplate x:DataType="local:CaseRecord">
                     <StackPanel Padding="4" Spacing="3"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Summary}" FontSize="12" TextWrapping="Wrap" Opacity="0.65"/></StackPanel>
                    </DataTemplate></ListView.ItemTemplate>
                   </ListView>
                  </TabViewItem>
                  <TabViewItem x:Name="DashboardCollectionTab" Header="Dashboard" IsClosable="False">
                    <ScrollViewer><StackPanel Padding="10" Spacing="8">
                      <ItemsControl x:Name="DashboardList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:DashboardMetric"><Grid Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label}"/><TextBlock Grid.Column="1" Text="{x:Bind Value}" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      <TextBlock Text="Pending actions" FontWeight="SemiBold" Margin="0,10,0,0"/>
                      <ListView x:Name="PendingList" MaxHeight="300"><ListView.ItemTemplate><DataTemplate x:DataType="local:CaseRecord"><StackPanel Margin="0,4"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Summary}" FontSize="12" Opacity="0.7"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                    </StackPanel></ScrollViewer>
                  </TabViewItem>
                  <TabViewItem x:Name="ActionsCollectionTab" Header="Next actions" IsClosable="False"><ListView x:Name="NextActionList"><ListView.ItemTemplate><DataTemplate x:DataType="local:NextActionItem"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="6"/></DataTemplate></ListView.ItemTemplate></ListView></TabViewItem>
                </TabView>
            </Grid>

            <Border Grid.Column="2" Margin="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><TabView x:Name="WorkspaceTabs">
                <TabViewItem x:Name="ReviewTab" Header="Review" IsClosable="False">
                    <ScrollViewer><StackPanel Padding="16" Spacing="14">
                        <TextBlock x:Name="SubjectText" Text="Select a message" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock x:Name="SenderText" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox x:Name="StatusBox" Header="Case status" Width="210" SelectionChanged="StatusBox_SelectionChanged">
                                <x:String>New</x:String><x:String>Investigating</x:String><x:String>Awaiting verification</x:String><x:String>Reported</x:String><x:String>Closed</x:String>
                            </ComboBox>
                            <Button Content="Check sender domain reputation" Click="Reputation_Click" VerticalAlignment="Bottom"/>
                            <Button x:Name="StopEngagementButton" Content="Stop engagement permanently" Click="StopEngagement_Click" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <InfoBar x:Name="RiskBar" IsOpen="False" IsClosable="False"/>
                        <TextBlock Text="Risk signals" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <ItemsControl x:Name="SignalList">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:RiskSignal">
                                <StackPanel Margin="0,4"><TextBlock Text="{x:Bind Label}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Opacity="0.72"/></StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Redacted message" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBox x:Name="MessageBody" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="220"/>
                    </StackPanel></ScrollViewer>
                </TabViewItem>
                <TabViewItem x:Name="ReplyTab" Header="Reply draft" IsClosable="False">
                    <ScrollViewer><StackPanel Padding="16" Spacing="12">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Manual engagement mode" Message="Use only a dedicated bait account and fictional persona. Never send secrets, real personal details, attachments, tracking links, threats, or claims of authority."/>
                        <TextBlock x:Name="RecipientText" Text="Select a message to lock the recipient" FontWeight="SemiBold"/>
                        <InfoBar x:Name="StoppedBar" IsOpen="False" IsClosable="False" Severity="Error" Title="Engagement stopped"/>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="PersonaBox" Header="Fictional persona" DisplayMemberPath="Display" SelectionChanged="PersonaBox_SelectionChanged"/>
                            <ComboBox x:Name="TemplateBox" Grid.Column="1" Header="Reply template" DisplayMemberPath="Display"/>
                            <Button Grid.Column="2" Content="Apply template" Click="ApplyTemplate_Click" VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBox x:Name="DraftBox" Header="Plain-text reply" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="240" TextChanged="DraftBox_TextChanged"/>
                        <InfoBar x:Name="PrivacyBar" IsOpen="True" IsClosable="False" Title="Privacy guard"/>
                        <ItemsControl x:Name="PrivacyFindings">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:PrivacyFinding"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <InfoBar x:Name="ConsistencyBar" IsOpen="True" IsClosable="False" Title="Persona consistency"/>
                        <ItemsControl x:Name="ConsistencyFindings"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:PrivacyFinding"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Copy draft" Click="CopyDraft_Click"/>
                            <Button Content="Suggest from case locally" Click="SuggestLocalReply_Click"/>
                            <Button x:Name="SendButton" Content="Review and send manually" Click="SendReply_Click" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock Text="Outbound audit log" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,10,0,0"/>
                        <ListView x:Name="OutboundList" MaxHeight="180">
                            <ListView.ItemTemplate><DataTemplate x:DataType="local:OutboundMessageRecord"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </StackPanel></ScrollViewer>
                </TabViewItem>
                <TabViewItem x:Name="NotesTab" Header="Evidence notes" IsClosable="False">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock Text="Record observations, verification steps, and reporting references. Do not store passwords or security codes." TextWrapping="Wrap"/>
                        <TextBox x:Name="NotesBox" Header="Case notes" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="300"/>
                    </StackPanel>
                </TabViewItem>
                <TabViewItem x:Name="TimelineTab" Header="Timeline" IsClosable="False">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock Text="Case activity" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <ListView x:Name="TimelineList">
                            <ListView.ItemTemplate><DataTemplate x:DataType="local:CaseEvent"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,5"/></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </TabViewItem>
                <TabViewItem x:Name="HeadersTab" Header="Header forensics" IsClosable="False">
                    <ScrollViewer><StackPanel Padding="16" Spacing="12">
                        <InfoBar x:Name="ForensicsBar" IsOpen="False" IsClosable="False"/>
                        <TextBlock Text="Identity and authentication" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <ItemsControl x:Name="ForensicsList">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ForensicFinding">
                                <Grid Margin="0,5" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{x:Bind Assessment}" Opacity="0.7"/></Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Warnings" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <ItemsControl x:Name="ForensicsWarnings"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Expander Header="Raw headers"><TextBox x:Name="RawHeadersBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" MinHeight="220"/></Expander>
                    </StackPanel></ScrollViewer>
                </TabViewItem>
                <TabViewItem x:Name="IndicatorsTab" Header="Indicators" IsClosable="False">
                    <Grid Padding="16" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Inert evidence" Message="Values are extracted locally. URLs are never opened directly; reputation checks require approval."/>
                        <ListView x:Name="IndicatorList" Grid.Row="1">
                            <ListView.ItemTemplate><DataTemplate x:DataType="local:IndicatorRecord">
                                <Grid Padding="4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind TypeDisplay}" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" FontFamily="Consolas"/><TextBlock Text="{x:Bind OccurrenceDisplay}" FontSize="12" Opacity="0.65"/></StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind PrimarySource}" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                                    <Button Grid.Column="3" Content="Copy" Click="CopyIndicator_Click"/>
                                    <Button Grid.Column="4" Content="Check reputation" Click="LookupIndicator_Click" IsEnabled="{x:Bind SupportsLookup}"/>
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>
                <TabViewItem x:Name="ReportTab" Header="Report" IsClosable="False">
                    <ScrollViewer><StackPanel Padding="16" Spacing="12">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Reporting assistant" Message="Creates a local redacted draft only. It does not upload evidence or submit a report."/>
                        <ComboBox x:Name="ReportDestinationBox" Header="Reporting destination" SelectedIndex="0">
                            <x:String>National fraud reporting service</x:String>
                            <x:String>Email provider abuse team</x:String>
                            <x:String>Bank or payment provider</x:String>
                            <x:String>Domain registrar or hosting provider</x:String>
                            <x:String>Police or law-enforcement reference</x:String>
                        </ComboBox>
                        <Button Content="Generate redacted report" Click="GenerateReport_Click" HorizontalAlignment="Left"/>
                        <TextBox x:Name="ReportBox" Header="Review before submitting" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="340"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Copy report" Click="CopyReport_Click"/>
                            <Button Content="Export evidence ZIP" Click="ExportEvidence_Click"/>
                        </StackPanel>
                    </StackPanel></ScrollViewer>
                </TabViewItem>
                <TabViewItem x:Name="ToolsTab" Header="Case tools" IsClosable="False">
                    <ScrollViewer><StackPanel Padding="16" Spacing="12">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Attachment quarantine" Message="Only attachment names, declared types, sizes, and content IDs are shown. The app provides no open, preview, save, or execute action."/>
                        <TextBlock Text="Inert attachment metadata" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <ListView x:Name="AttachmentList" MaxHeight="180"><ListView.ItemTemplate><DataTemplate x:DataType="local:AttachmentRecord"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ListView.ItemTemplate></ListView>
                        <TextBlock Text="Possible duplicate cases" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <ListView x:Name="DuplicateList" MaxHeight="180"><ListView.ItemTemplate><DataTemplate x:DataType="local:DuplicateCaseMatch"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ListView.ItemTemplate></ListView>
                        <TextBlock Text="Manual follow-up reminders" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Add reminder" Click="AddReminder_Click"/><Button Content="Mark selected complete" Click="CompleteReminder_Click"/></StackPanel>
                        <ListView x:Name="ReminderList" MaxHeight="180"><ListView.ItemTemplate><DataTemplate x:DataType="local:FollowUpReminder"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ListView.ItemTemplate></ListView>
                        <Button Content="Export lightweight case summary" Click="ExportSummary_Click" HorizontalAlignment="Left"/>
                    </StackPanel></ScrollViewer>
                </TabViewItem>
                <TabViewItem x:Name="PlanTab" Header="Engagement plan" IsClosable="False">
                    <ScrollViewer><StackPanel Padding="16" Spacing="12">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Controlled plan" Message="Objectives and questions organise manual work. Nothing here sends messages or performs external actions."/>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="EngagementStageBox" Header="Conversation stage" SelectedIndex="0"><x:String>Initial review</x:String><x:String>Verification questions</x:String><x:String>Claims under review</x:String><x:String>Awaiting response</x:String><x:String>Ready to report</x:String><x:String>Ended</x:String></ComboBox>
                            <TextBox x:Name="EngagementObjectiveBox" Grid.Column="1" Header="Current objective"/>
                        </Grid>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <NumberBox x:Name="MessageBudgetBox" Header="Total reply budget" Minimum="1" Maximum="50" Value="10"/>
                            <DatePicker x:Name="EngagementDeadlinePicker" Grid.Column="1" Header="Engagement deadline"/>
                            <Button Grid.Column="2" Content="Save plan" Click="SaveEngagementPlan_Click" VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBlock Text="Safe question bank" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="QuestionBox" DisplayMemberPath="Display"/><Button Grid.Column="1" Content="Add to reply draft" Click="ApplyQuestion_Click"/></Grid>
                        <TextBlock Text="Sender claim ledger" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Record sender claim" Click="AddClaim_Click"/><Button Content="Mark selected contradicted" Click="ContradictClaim_Click"/></StackPanel>
                        <ListView x:Name="ClaimList" MaxHeight="260"><ListView.ItemTemplate><DataTemplate x:DataType="local:SenderClaim"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ListView.ItemTemplate></ListView>
                        <TextBlock Text="Passive indicator intake" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="No prospecting" Message="Add only indicators from reports or messages you are authorised to investigate. This never searches for addresses or starts contact."/>
                        <Button Content="Add sourced indicator" Click="AddSourcedIndicator_Click" HorizontalAlignment="Left"/>
                        <ListView x:Name="SourcedIndicatorList" MaxHeight="180"><ListView.ItemTemplate><DataTemplate x:DataType="local:ProvenanceIndicator"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ListView.ItemTemplate></ListView>
                    </StackPanel></ScrollViewer>
                </TabViewItem>
                <TabViewItem x:Name="SettingsTab" Header="Settings" IsClosable="False">
                    <ScrollViewer><StackPanel Padding="20" Spacing="16" MaxWidth="850" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontSize="28"/>
                        <Border Style="{StaticResource WorkspaceCard}"><StackPanel Spacing="10"><TextBlock Text="Mail account" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock Text="Configure only your dedicated bait mailbox. Credentials are stored in Windows Credential Locker." TextWrapping="Wrap" Opacity="0.7"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Inbox settings" Click="Settings_Click"/><Button Content="Connect Gmail OAuth" Click="ConnectGmail_Click"/><Button Content="Test connection" Click="TestConnection_Click"/></StackPanel></StackPanel></Border>
                        <Border Style="{StaticResource WorkspaceCard}"><StackPanel Spacing="10"><TextBlock Text="Inbox monitoring" Style="{ThemeResource SubtitleTextBlockStyle}"/><InfoBar x:Name="MonitorBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Inbox monitor off" Message="Enable monitoring to check every 60 seconds while the app is open."/><AppBarToggleButton x:Name="SettingsMonitorButton" Icon="World" Label="Monitor inbox" Click="Monitor_Click" HorizontalAlignment="Left"/></StackPanel></Border>
                        <Border Style="{StaticResource WorkspaceCard}"><StackPanel Spacing="10"><TextBlock Text="Application updates" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock Text="Pull the latest main branch, rebuild, register the new package, and reopen ScamBait Desk automatically." TextWrapping="Wrap" Opacity="0.7"/><Button Content="Update app now" Click="UpdateApp_Click" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Border>
                        <Border Style="{StaticResource WorkspaceCard}"><StackPanel><TextBlock Text="Connection diagnostics" Style="{ThemeResource SubtitleTextBlockStyle}"/><ListView x:Name="DiagnosticList" MaxHeight="220"><ListView.ItemTemplate><DataTemplate x:DataType="local:ConnectionDiagnostic"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,5"/></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabViewItem>
                <TabViewItem x:Name="InsightTab" Header="Conversation insight" IsClosable="False">
                    <ScrollViewer><StackPanel Padding="16" Spacing="12">
                        <TextBlock x:Name="ConversationOverview" Text="Open a case to build a local summary." Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="Extracted requests and claims" FontWeight="SemiBold"/>
                        <ListView x:Name="ConversationFactList" MaxHeight="220"><ListView.ItemTemplate><DataTemplate x:DataType="local:ConversationFact"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ListView.ItemTemplate></ListView>
                        <TextBlock Text="Potential contradictions" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="ContradictionList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="Unanswered verification questions" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="UnansweredQuestionList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></ScrollViewer>
                </TabViewItem>
            </TabView></Border>
        </Grid>
    </Grid>
</Window>
